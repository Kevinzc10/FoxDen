# Public client configuration
# Values prefixed with EXPO_PUBLIC_ are bundled into the Expo client. Never put
# server-only secrets (such as a Supabase service-role key or AI provider key)
# in an EXPO_PUBLIC_ variable.

# Existing API domain used by FoxScan and Study Planner (without https://)
EXPO_PUBLIC_DOMAIN=

# Supabase client configuration. These are safe to expose in an Expo client
# when Row Level Security is enabled; do not use the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
